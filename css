/* إصلاح مشكلة عدم تطبيق الخط */
@font-face {
    font-family: 'CustomFont';
    /* تأكد أن المسار دقيق أو استخدم الرابط المباشر (Raw) إذا كان مرفوعاً على GitHub */
    src: url('font.woff') format('woff');
    font-weight: normal;
    font-style: normal;
    font-display: swap; 
}

body {
    /* فرض تطبيق الخط واستخدام خطوط احتياطية */
    font-family: 'CustomFont', Arial, Tahoma, sans-serif !important;
    background-color: #faf8f5;
    color: #2c3e50;
    direction: rtl;
    text-align: right;
    margin: 0;
    padding: 50px;
}
